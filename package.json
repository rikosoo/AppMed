{
  "name": "financemed-ai",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test:e2e": "playwright test",
    "test:api": "cd services/api && ../../.venv/bin/python -m pytest -q",
    "test:proxy": "node --test tests/api-proxy.test.mjs",
    "dev:web": "node scripts/dev.mjs --web-only",
    "dev:api": "node scripts/dev.mjs --api-only",
    "test:launcher": "node --test tests/dev-launcher.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATABASE_PATH=/data/financemed.sqlite3
WORKDIR /app
COPY services/api/requirements.runtime.lock /app/requirements.runtime.lock
RUN --mount=type=secret,id=build_ca if [ -f /run/secrets/build_ca ]; then export PIP_CERT=/run/secrets/build_ca; fi; pip install --no-cache-dir -r requirements.runtime.lock && useradd --create-home --uid 10001 financemed && mkdir -p /data && chown financemed:financemed /data && chmod 700 /data
COPY --chown=financemed:financemed services/api/ /app/
USER financemed
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

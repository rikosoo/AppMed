APP_DOMAIN=finance.seudominio.com.br
APP_ORIGIN=https://finance.seudominio.com.br

# Recuperação de senha: configure credenciais reais somente em deploy/.env no servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Gerado no servidor por scripts/configure-proxy-token.py; não compartilhe este valor.
INTERNAL_PROXY_TOKEN=
